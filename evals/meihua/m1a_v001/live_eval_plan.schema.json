    "authorization",
    "automatic_success_thresholds",
    "budgets_usd",
    "case_counts",
    "conversation",
    "data_policy",
    "limits",
    "manual_scoring_thresholds",
    "max_input_tokens_per_request",
    "max_output_tokens",
    "model_id",
    "plan_status",
    "plan_version",
    "previous_response_id",
    "reasoning",
    "release",
    "stop_conditions",
    "store",
    "tools"

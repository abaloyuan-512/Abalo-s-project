{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_type": {"const": "RESPONSES_API"},
    "authorization": {"type": "object"},
    "automatic_success_thresholds": {"type": "object"},
    "budgets_usd": {"type": "object"},
    "case_counts": {"type": "object"},
    "conversation": {"type": "null"},
    "data_policy": {"const": "SYNTHETIC_FIXTURES_ONLY"},
    "limits": {"type": "object"},
    "manual_scoring_thresholds": {"type": "object"},
    "max_input_tokens_per_request": {"const": 20000},
    "max_output_tokens": {"const": 25000},
    "model_id": {"const": "gpt-5.6-terra"},
    "plan_status": {"const": "FROZEN"},
    "plan_version": {"const": "1.0"},
    "previous_response_id": {"type": "null"},

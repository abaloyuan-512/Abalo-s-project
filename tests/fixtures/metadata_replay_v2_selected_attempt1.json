        "narrative_kind": "REVIEW_QUESTION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "CHART_EVIDENCE"
      },
      {
        "text": "\u4f60\u76ee\u524d\u7684\u914d\u5408\u662f\u5426\u4ecd\u4fdd\u7559\u4e86\u81ea\u4e3b\u5224\u65ad\u3001\u9009\u62e9\u6743\u548c\u53ef\u627f\u53d7\u7684\u9650\u5ea6\uff1f",
        "evidence_ids": [
          "D-H-2"
        ],
        "narrative_kind": "REVIEW_QUESTION",
        "subject_scope": "USER",
        "epistemic_basis": "CHART_EVIDENCE"
      },
      {
        "text": "\u53cc\u65b9\u662f\u5426\u5df2\u7ecf\u5f62\u6210\u6e05\u695a\u4e14\u53ef\u88ab\u5b9e\u9645\u9075\u5b88\u7684\u8d23\u4efb\u5206\u5de5\u4e0e\u4e92\u52a8\u89c4\u5219\uff1f",
        "evidence_ids": [

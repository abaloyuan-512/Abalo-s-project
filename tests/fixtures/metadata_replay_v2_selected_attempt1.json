    "conditions_that_change_outcome": [],
    "review_questions": [
      {
        "text": "\u5bf9\u65b9\u662f\u5426\u613f\u610f\u5171\u540c\u786e\u8ba4\u5f7c\u6b64\u7684\u8d23\u4efb\u8303\u56f4\u548c\u8fb9\u754c\uff0c\u800c\u4e0d\u53ea\u662f\u7531\u4f60\u5355\u65b9\u9762\u8c03\u6574\uff1f",

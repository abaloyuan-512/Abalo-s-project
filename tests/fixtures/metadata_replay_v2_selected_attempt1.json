    "real_world_advice": [
      {
        "text": "\u53ef\u4ee5\u8003\u8651\u5148\u4ee5\u4e00\u6b21\u5177\u4f53\u3001\u53ef\u6838\u5bf9\u7684\u6c9f\u901a\u6f84\u6e05\u53cc\u65b9\u5bf9\u5173\u7cfb\u4e0e\u672a\u6765\u5b89\u6392\u7684\u7406\u89e3\uff0c\u518d\u51b3\u5b9a\u662f\u5426\u63d0\u51fa\u786e\u8ba4\u8981\u6c42\u3002",
        "evidence_ids": [
          "E02",
          "E03"
        ],
        "narrative_kind": "ACTION_OPTION",
        "subject_scope": "USER",
        "epistemic_basis": "ACTION_OPTION"
      },
      {
        "text": "\u5efa\u8bae\u9a8c\u8bc1\u5bf9\u65b9\u662f\u5426\u80fd\u5bf9\u5173\u952e\u95ee\u9898\u7ed9\u51fa\u4e00\u81f4\u3001\u53ef\u843d\u5b9e\u7684\u56de\u5e94\uff1b\u82e5\u4ecd\u7136\u6a21\u7cca\uff0c\u53ef\u5148\u907f\u514d\u4f5c\u51fa\u9ad8\u6295\u5165\u6216\u96be\u4ee5\u56de\u8f6c\u7684\u627f\u8bfa\u3002",

        ],
        "narrative_kind": "EXPLANATION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "UNCERTAINTY"
      },
      {
        "text": "\u5f53\u524d\u66f4\u503c\u5f97\u5173\u6ce8\u7684\u662f\uff1a\u53cc\u65b9\u662f\u5426\u80fd\u628a\u672a\u6765\u5b89\u6392\u3001\u5404\u81ea\u671f\u5f85\u548c\u53ef\u843d\u5b9e\u7684\u8fb9\u754c\u8bf4\u6e05\u695a\uff0c\u800c\u4e0d\u662f\u628a\u542b\u7cca\u56de\u5e94\u76f4\u63a5\u89c6\u4e3a\u80af\u5b9a\u6216\u5426\u5b9a\u3002",

  "CASE-002_medium_1": {
    "plain_language_explanation": [
      {
        "text": "\u8fd9\u7c7b\u5904\u5883\u7684\u91cd\u70b9\u4e0d\u53ea\u662f\u7ef4\u6301\u8868\u9762\u548c\u5e73\uff0c\u8fd8\u5305\u62ec\u5728\u914d\u5408\u4e2d\u4fdd\u7559\u81ea\u5df1\u7684\u5224\u65ad\u3001\u8d23\u4efb\u8303\u56f4\u548c\u53ef\u63a5\u53d7\u7684\u754c\u9650\u3002",

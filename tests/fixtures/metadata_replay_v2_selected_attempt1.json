          "E03"
        ],
        "narrative_kind": "ACTION_OPTION",
        "subject_scope": "USER",
        "epistemic_basis": "ACTION_OPTION"
      },
      {
        "text": "\u53ef\u5148\u5c1d\u8bd5\u7528\u7b80\u77ed\u800c\u660e\u786e\u7684\u8868\u8fbe\u8bf4\u660e\u81ea\u5df1\u7684\u9700\u6c42\u3001\u5e95\u7ebf\u4e0e\u5e0c\u671b\u4e86\u89e3\u7684\u4e8b\u9879\uff0c\u5e76\u7ed9\u5bf9\u65b9\u7559\u51fa\u8bf4\u660e\u73b0\u5b9e\u987e\u8651\u7684\u7a7a\u95f4\u3002",

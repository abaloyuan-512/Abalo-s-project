  "CASE-009_low_1": {
    "plain_language_explanation": [
      {
        "text": "\u73b0\u6709\u4fe1\u606f\u4e0d\u8db3\u4ee5\u786e\u8ba4\u5bf9\u65b9\u7684\u771f\u5b9e\u60f3\u6cd5\uff1b\u5728\u56de\u5e94\u542b\u7cca\u3001\u5173\u952e\u4e8b\u5b9e\u672a\u5398\u6e05\u7684\u60c5\u51b5\u4e0b\uff0c\u76f4\u63a5\u63a8\u52a8\u5173\u7cfb\u786e\u8ba4\u53ef\u80fd\u589e\u52a0\u6c9f\u901a\u538b\u529b\u4e0e\u8bef\u89e3\u3002",

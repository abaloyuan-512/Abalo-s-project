        ],
        "narrative_kind": "EXPLANATION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "CHART_EVIDENCE"
      },
      {
        "text": "\u5982\u679c\u8fb9\u754c\u4e0e\u8d23\u4efb\u957f\u671f\u8bf4\u4e0d\u6e05\uff0c\u53cd\u590d\u51b2\u7a81\u53ef\u80fd\u4f1a\u8ba9\u53cc\u65b9\u90fd\u627f\u53d7\u635f\u8017\uff1b\u5355\u9760\u4e00\u65b9\u6301\u7eed\u9000\u8ba9\uff0c\u672a\u5fc5\u80fd\u5904\u7406\u95ee\u9898\u7684\u6839\u6e90\u3002",
        "evidence_ids": [
          "D-L-2-6"
        ],
        "narrative_kind": "EXPLANATION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "CHART_EVIDENCE"
      },
      {
        "text": "\u5173\u7cfb\u4e2d\u7684\u4e92\u52a8\u4ecd\u53ef\u80fd\u5b58\u5728\u534f\u8c03\u7a7a\u95f4\uff0c\u4f46\u662f\u5426\u80fd\u6539\u5584\uff0c\u53d6\u51b3\u4e8e\u53cc\u65b9\u80fd\u5426\u628a\u5206\u6b67\u8f6c\u5316\u4e3a\u6e05\u695a\u7684\u89c4\u5219\u548c\u53ef\u6267\u884c\u7684\u5b89\u6392\u3002",
        "evidence_ids": [
          "E02",
          "E03"
        ],
        "narrative_kind": "EXPLANATION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "CHART_EVIDENCE"
      }
    ],
    "real_world_advice": [
      {
        "text": "\u53ef\u4ee5\u8003\u8651\u5148\u628a\u6700\u5bb9\u6613\u5f15\u53d1\u4e89\u6267\u7684\u8fb9\u754c\u3001\u8d23\u4efb\u548c\u6c9f\u901a\u65b9\u5f0f\u5199\u6e05\u695a\uff0c\u5e76\u8bf4\u660e\u81ea\u5df1\u613f\u610f\u914d\u5408\u7684\u8303\u56f4\u4e0e\u4e0d\u80fd\u63a5\u53d7\u7684\u90e8\u5206\u3002",
        "evidence_ids": [
          "D-H-2"
        ],
        "narrative_kind": "ACTION_OPTION",
        "subject_scope": "USER",
        "epistemic_basis": "ACTION_OPTION"
      },
      {
        "text": "\u5efa\u8bae\u9a8c\u8bc1\u6bcf\u6b21\u9000\u8ba9\u662f\u5426\u5e26\u6765\u4e86\u66f4\u6e05\u695a\u7684\u5206\u5de5\u548c\u66f4\u5c11\u7684\u51b2\u7a81\uff1b\u82e5\u6ca1\u6709\uff0c\u53ef\u5148\u5c1d\u8bd5\u505c\u6b62\u56f4\u7ed5\u201c\u8c01\u5b8c\u5168\u6b63\u786e\u201d\u7ee7\u7eed\u62c9\u626f\u3002",
        "evidence_ids": [
          "D-L-2-6"
        ],
        "narrative_kind": "ACTION_OPTION",
        "subject_scope": "USER",
        "epistemic_basis": "ACTION_OPTION"
      },
      {
        "text": "\u53ef\u4ee5\u8003\u8651\u5728\u6c9f\u901a\u4e2d\u805a\u7126\u5177\u4f53\u884c\u4e3a\u3001\u8d23\u4efb\u548c\u540e\u7eed\u5904\u7406\u65b9\u5f0f\uff0c\u800c\u4e0d\u662f\u8981\u6c42\u5bf9\u65b9\u731c\u6d4b\u4f60\u7684\u5e95\u7ebf\u3002",
        "evidence_ids": [
          "D-H-2",

  "CASE-002_low_1": {
    "plain_language_explanation": [
      {
        "text": "\u5728\u5173\u7cfb\u4fee\u590d\u4e2d\uff0c\u914d\u5408\u53ef\u4ee5\u662f\u6709\u539f\u5219\u7684\u534f\u4f5c\uff1a\u5148\u5398\u6e05\u5404\u81ea\u8d23\u4efb\u4e0e\u8fb9\u754c\uff0c\u518d\u51b3\u5b9a\u81ea\u5df1\u613f\u610f\u627f\u62c5\u54ea\u4e9b\u90e8\u5206\uff0c\u907f\u514d\u628a\u652f\u6301\u5bf9\u65b9\u7b49\u540c\u4e8e\u653e\u5f03\u5224\u65ad\u3002",
        "evidence_ids": [
          "D-H-2"
        ],
        "narrative_kind": "EXPLANATION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "CHART_EVIDENCE"
      },
      {
        "text": "\u53cd\u590d\u4e89\u6267\u82e5\u9010\u6e10\u6f14\u53d8\u4e3a\u4e89\u593a\u4e3b\u5bfc\u6216\u8bc1\u660e\u8c01\u7edd\u5bf9\u6b63\u786e\uff0c\u53cc\u65b9\u90fd\u53ef\u80fd\u627f\u53d7\u635f\u8017\uff1b\u91cd\u70b9\u53ef\u653e\u5728\u505c\u6b62\u5347\u7ea7\u3001\u6062\u590d\u8fb9\u754c\u4e0e\u89c4\u5219\u4e0a\u3002",
        "evidence_ids": [
          "D-L-2-6"
        ],
        "narrative_kind": "EXPLANATION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "CHART_EVIDENCE"
      },
      {
        "text": "\u5f53\u524d\u66f4\u503c\u5f97\u5173\u6ce8\u7684\u4e0d\u662f\u5355\u7eaf\u575a\u6301\u6216\u5355\u7eaf\u9000\u8ba9\uff0c\u800c\u662f\u53cc\u65b9\u80fd\u5426\u5f62\u6210\u8f83\u4e3a\u5bf9\u7b49\u3001\u53ef\u6301\u7eed\u7684\u4e92\u52a8\u5b89\u6392\u3002",
        "evidence_ids": [
          "E02",
          "E03"
        ],
        "narrative_kind": "EXPLANATION",
        "subject_scope": "SITUATION",
        "epistemic_basis": "CHART_EVIDENCE"
      }
    ],
    "real_world_advice": [
      {
        "text": "\u53ef\u4ee5\u8003\u8651\u5148\u628a\u5177\u4f53\u4e89\u8bae\u62c6\u5f00\uff0c\u660e\u786e\u54ea\u4e9b\u8d23\u4efb\u53ef\u4ee5\u534f\u5546\u3001\u54ea\u4e9b\u8fb9\u754c\u4e0d\u53ef\u8ba9\u6b65\uff0c\u5e76\u4ee5\u53cc\u65b9\u90fd\u80fd\u6267\u884c\u7684\u65b9\u5f0f\u8868\u8fbe\u3002",
        "evidence_ids": [
          "D-H-2"
        ],
        "narrative_kind": "ACTION_OPTION",
        "subject_scope": "USER",
        "epistemic_basis": "ACTION_OPTION"
      },
      {
        "text": "\u53ef\u5148\u5c1d\u8bd5\u964d\u4f4e\u6b63\u9762\u51b2\u7a81\u7684\u9891\u7387\u4e0e\u5f3a\u5ea6\uff1b\u82e5\u6c9f\u901a\u603b\u662f\u56de\u5230\u6307\u8d23\u6216\u5bf9\u6297\uff0c\u5efa\u8bae\u9a8c\u8bc1\u662f\u5426\u9700\u8981\u501f\u52a9\u53cc\u65b9\u8ba4\u53ef\u7684\u89c4\u5219\u3001\u534f\u8c03\u65b9\u5f0f\u6216\u9000\u51fa\u673a\u5236\u3002",
        "evidence_ids": [
          "D-L-2-6"
        ],
        "narrative_kind": "ACTION_OPTION",
        "subject_scope": "USER",
        "epistemic_basis": "ACTION_OPTION"
      },
      {
        "text": "\u53ef\u4ee5\u8003\u8651\u628a\u201c\u8fc1\u5c31\u201d\u6539\u4e3a\u6709\u6761\u4ef6\u7684\u914d\u5408\uff1a\u8bf4\u660e\u81ea\u5df1\u613f\u610f\u505a\u51fa\u7684\u8c03\u6574\uff0c\u540c\u65f6\u63d0\u51fa\u5bf9\u65b9\u4e5f\u9700\u627f\u62c5\u7684\u5177\u4f53\u8d23\u4efb\u3002",
        "evidence_ids": [
          "D-H-2",
          "D-L-2-6"
        ],
        "narrative_kind": "ACTION_OPTION",
        "subject_scope": "USER",
        "epistemic_basis": "ACTION_OPTION"
      }
    ],
    "conditions_that_change_outcome": [],
    "review_questions": [
      {
        "text": "\u5f53\u4f60\u8868\u8fbe\u8fb9\u754c\u6216\u8d23\u4efb\u8981\u6c42\u65f6\uff0c\u5bf9\u65b9\u662f\u5426\u80fd\u5c31\u5177\u4f53\u4e8b\u9879\u56de\u5e94\uff0c\u800c\u975e\u628a\u8ba8\u8bba\u8f6c\u4e3a\u6307\u8d23\u3001\u56de\u907f\u6216\u4e89\u593a\u5bf9\u9519\uff1f",
        "evidence_ids": [

  "plain_language_explanation": [
    {
      "text": "\u5f53\u524d\u66f4\u9002\u5408\u628a\u4f18\u52bf\u8f6c\u5316\u4e3a\u6709\u8fb9\u754c\u3001\u53ef\u6267\u884c\u7684\u63a8\u8fdb\u65b9\u5f0f\uff0c\u800c\u4e0d\u662f\u628a\u5f3a\u786c\u672c\u8eab\u5f53\u4f5c\u76ee\u6807\u3002\u529b\u91cf\u80fd\u5426\u53d1\u6325\u4f5c\u7528\uff0c\u53d6\u51b3\u4e8e\u76ee\u6807\u662f\u5426\u6b63\u5f53\u3001\u89c4\u5219\u662f\u5426\u6e05\u695a\uff0c\u4ee5\u53ca\u884c\u52a8\u662f\u5426\u4e0e\u8d23\u4efb\u76f8\u5339\u914d\u3002",

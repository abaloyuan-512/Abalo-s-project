{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abalo:sites-meihua:v1:request",
  "title": "Sites Meihua Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "question_text", "numbers", "locale", "client_timestamp", "user_acknowledgements"],
  "properties": {
    "contract_version": {"const": "SITES_MEIHUA_API_CONTRACT_V1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
    "question_text": {"type": "string", "minLength": 1, "maxLength": 500},
    "numbers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 999}},
    "locale": {"const": "zh-CN"},
    "client_timestamp": {"type": "string", "format": "date-time", "description": "Audit only; never determines chart facts."},
    "user_acknowledgements": {
      "type": "object", "additionalProperties": false,
      "required": ["deterministic_only", "narrative_unverified"],
      "properties": {"deterministic_only": {"const": true}, "narrative_unverified": {"const": true}}
    }
  }
}

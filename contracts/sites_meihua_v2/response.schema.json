{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abalo:sites-meihua:v2:response",
  "title": "Sites Meihua Structured Response V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "status", "deterministic_result", "narrative", "release_gate", "audit", "errors"],
  "properties": {
    "contract_version": {"const": "SITES_MEIHUA_API_CONTRACT_V2"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["SUCCESS", "VALIDATION_ERROR", "ENGINE_ERROR", "RELEASE_BLOCKED"]},
    "structured_intake": {
      "type": "object", "additionalProperties": false,
      "required": ["question_domain", "decision_goal", "time_horizon"],
      "properties": {
        "question_domain": {"enum": ["WORK_CAREER", "PROJECT_COOPERATION", "RELATIONSHIP_COMMUNICATION", "PERSONAL_PLANNING"]},
        "decision_goal": {"enum": ["IDENTIFY_OBSTACLES", "PLAN_NEXT_STEP", "PREPARE_COMMUNICATION", "ADJUST_COMMITMENT_BOUNDARIES", "OBSERVE_VERIFY_SIGNALS"]},
        "time_horizon": {"enum": ["CURRENT", "NEXT_30_DAYS", "NEXT_QUARTER", "NEXT_6_MONTHS"]}
      }
    },
    "normalized_question": {"type": "string", "minLength": 1, "maxLength": 500},
    "question_template_version": {"const": "SITES_STRUCTURED_QUESTION_TEMPLATE_V1"},
    "deterministic_result": {"oneOf": [{"$ref": "#/$defs/deterministic_result"}, {"type": "null"}]},
    "narrative": {"$ref": "#/$defs/narrative"},
    "release_gate": {"$ref": "#/$defs/release_gate"},
    "audit": {"$ref": "#/$defs/audit"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "SUCCESS"}}, "required": ["status"]}, "then": {"required": ["structured_intake", "normalized_question", "question_template_version"], "properties": {"deterministic_result": {"$ref": "#/$defs/deterministic_result"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["VALIDATION_ERROR", "ENGINE_ERROR", "RELEASE_BLOCKED"]}}, "required": ["status"]}, "then": {"not": {"anyOf": [{"required": ["structured_intake"]}, {"required": ["normalized_question"]}, {"required": ["question_template_version"]}]}, "properties": {"deterministic_result": {"type": "null"}, "errors": {"minItems": 1}}}}
  ],
  "$defs": {
    "narrative": {"type": "object", "additionalProperties": false, "required": ["status", "available", "content", "blocked_reason", "live_validation_status"], "properties": {"status": {"const": "UNVERIFIED"}, "available": {"const": false}, "content": {"type": "null"}, "blocked_reason": {"type": "string", "minLength": 1}, "live_validation_status": {"const": "BLOCKED_BY_EXECUTION_POLICY"}}},
    "release_gate": {"type": "object", "additionalProperties": false, "required": ["should_charge", "formal_report_persistence_allowed", "closed_beta_allowed", "narrative_release_status"], "properties": {"should_charge": {"const": false}, "formal_report_persistence_allowed": {"const": false}, "closed_beta_allowed": {"const": false}, "narrative_release_status": {"const": "UNVERIFIED"}}},
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["engine_version", "contract_version", "calculation_source", "generated_at", "synthetic_or_real_input", "request_hash", "audit_id", "question_template_version"],
      "properties": {
        "engine_version": {"type": ["string", "null"]},
        "contract_version": {"const": "SITES_MEIHUA_API_CONTRACT_V2"},
        "calculation_source": {"const": "PYTHON_AUTHORITATIVE_ENGINE"},
        "generated_at": {"type": "string", "format": "date-time"},
        "client_timestamp": {"type": "string", "format": "date-time"},
        "client_timestamp_used_for_calculation": {"const": false},
        "synthetic_or_real_input": {"enum": ["SYNTHETIC", "REAL", "UNSPECIFIED"]},
        "request_hash": {"oneOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
        "audit_id": {"type": "string", "pattern": "^audit-[a-f0-9]{16}$"},
        "question_template_version": {"oneOf": [{"const": "SITES_STRUCTURED_QUESTION_TEMPLATE_V1"}, {"type": "null"}]}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["error_code", "message", "request_id", "audit_id"],
      "properties": {
        "error_code": {"enum": ["INVALID_REQUEST", "INVALID_NUMBER_COUNT", "INVALID_NUMBER_TYPE", "CLIENT_INPUT_NOT_ACCEPTED", "ENGINE_ERROR", "NARRATIVE_UNVERIFIED", "FORMAL_PERSISTENCE_BLOCKED", "CHARGING_BLOCKED", "CLOSED_BETA_BLOCKED"]},
        "message": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "anyOf": [{"const": "invalid-request"}, {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}]},
        "audit_id": {"type": "string", "pattern": "^audit-[a-f0-9]{16}$"}
      }
    },
    "deterministic_result": {
      "type": "object", "additionalProperties": false,
      "required": ["input_numbers", "base_hexagram", "mutual_hexagram", "changed_hexagram", "moving_line", "body_use", "five_elements", "seasonal_strength", "deterministic_conclusion", "evidence_summary"],
      "properties": {
        "input_numbers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 999}},
        "base_hexagram": {"$ref": "#/$defs/hexagram"},
        "mutual_hexagram": {"$ref": "#/$defs/hexagram"},
        "changed_hexagram": {"$ref": "#/$defs/hexagram"},
        "moving_line": {"type": "integer", "minimum": 1, "maximum": 6},
        "body_use": {"$ref": "#/$defs/body_use"},
        "five_elements": {"$ref": "#/$defs/five_elements"},
        "seasonal_strength": {"$ref": "#/$defs/seasonal_strength"},
        "deterministic_conclusion": {"$ref": "#/$defs/deterministic_conclusion"},
        "mentor_report": {"$ref": "#/$defs/mentor_report"},
        "evidence_summary": {"$ref": "#/$defs/evidence_summary"}
      }
    },
    "hexagram": {"type": "object", "additionalProperties": false, "required": ["king_wen_number", "name", "symbol"], "properties": {"king_wen_number": {"type": "integer", "minimum": 1, "maximum": 64}, "name": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}}},
    "body_use_relation": {"enum": ["USE_GENERATES_BODY", "BODY_CONTROLS_USE", "SAME_ELEMENT", "BODY_GENERATES_USE", "USE_CONTROLS_BODY"]},
    "strength": {"enum": ["PROSPEROUS", "SUPPORTED", "RESTING", "CONFINED", "DEAD"]},
    "body_use": {
      "type": "object", "additionalProperties": false,
      "required": ["body_trigram", "initial_use_trigram", "changed_use_trigram", "initial_relation", "changed_relation"],
      "properties": {
        "body_trigram": {"type": "string", "minLength": 1},
        "initial_use_trigram": {"type": "string", "minLength": 1},
        "changed_use_trigram": {"type": "string", "minLength": 1},
        "initial_relation": {"$ref": "#/$defs/body_use_relation"},
        "changed_relation": {"$ref": "#/$defs/body_use_relation"}
      }
    },
    "five_elements": {
      "type": "object", "additionalProperties": false,
      "required": ["body", "initial_use", "changed_use"],
      "properties": {"body": {"type": "string", "minLength": 1}, "initial_use": {"type": "string", "minLength": 1}, "changed_use": {"type": "string", "minLength": 1}}
    },
    "seasonal_strength": {
      "type": "object", "additionalProperties": false,
      "required": ["body", "initial_use", "changed_use", "solar_term", "month_branch"],
      "properties": {
        "body": {"$ref": "#/$defs/strength"},
        "initial_use": {"$ref": "#/$defs/strength"},
        "changed_use": {"$ref": "#/$defs/strength"},
        "solar_term": {"type": "string", "minLength": 1},
        "month_branch": {"type": "string", "minLength": 1}
      }
    },
    "relation_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "relation", "direction", "strength", "body_strength", "use_strength", "modifier_rule_ids", "evidence_ids", "conditions", "warnings"],
      "properties": {
        "phase": {"enum": ["INITIAL", "CHANGED"]},
        "relation": {"$ref": "#/$defs/body_use_relation"},
        "direction": {"enum": ["FAVORABLE", "MIXED", "UNFAVORABLE"]},
        "strength": {"enum": ["STRONG", "MEDIUM", "WEAK"]},
        "body_strength": {"$ref": "#/$defs/strength"},
        "use_strength": {"$ref": "#/$defs/strength"},
        "modifier_rule_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deterministic_conclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["conclusion_level", "evidence_sufficiency", "supporting_evidence_ids", "blocking_evidence_ids", "conflicting_evidence_ids", "required_conditions", "synthesis_rule_ids", "warnings", "relation_assessments"],
      "properties": {
        "conclusion_level": {"enum": ["CLEARLY_FAVORABLE", "CONDITIONALLY_FAVORABLE", "MIXED_OR_UNSETTLED", "CLEARLY_UNFAVORABLE", "INSUFFICIENT_EVIDENCE"]},
        "evidence_sufficiency": {"enum": ["SUFFICIENT", "LIMITED", "INSUFFICIENT"]},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "blocking_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "conflicting_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "required_conditions": {"type": "array", "items": {"type": "string"}},
        "synthesis_rule_ids": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "relation_assessments": {"type": "array", "items": {"$ref": "#/$defs/relation_assessment"}}
      }
    },
    "mentor_text_item": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "mentor_action_item": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "action", "why"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1}
      }
    },
    "mentor_report": {
      "type": "object", "additionalProperties": false,
      "required": ["template_version", "opening", "reading_guide", "reasoning", "action_plan", "cautions", "review_questions", "boundary_note"],
      "properties": {
        "template_version": {"const": "SITES_MENTOR_REPORT_V1"},
        "opening": {"type": "string", "minLength": 1},
        "reading_guide": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/mentor_text_item"}},
        "reasoning": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mentor_text_item"}},
        "action_plan": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/mentor_action_item"}},
        "cautions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "boundary_note": {"type": "string", "minLength": 1}
      }
    },
    "evidence_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "evidence_types", "knowledge_mode", "approved_knowledge_items_used"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "evidence_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "knowledge_mode": {"enum": ["PRODUCTION", "INTERNAL_REVIEW", "INTERNAL_DRAFT_PREVIEW"]},
        "approved_knowledge_items_used": {"type": "integer", "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abalo:sites-meihua:v2:error",
  "title": "Sites Meihua Error V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_code", "message", "request_id", "audit_id"],
  "properties": {
    "error_code": {"enum": ["INVALID_REQUEST", "INVALID_NUMBER_COUNT", "INVALID_NUMBER_TYPE", "CLIENT_INPUT_NOT_ACCEPTED", "ENGINE_ERROR", "NARRATIVE_UNVERIFIED", "FORMAL_PERSISTENCE_BLOCKED", "CHARGING_BLOCKED", "CLOSED_BETA_BLOCKED"]},
    "message": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "anyOf": [{"const": "invalid-request"}, {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}]},
    "audit_id": {"type": "string", "pattern": "^audit-[a-f0-9]{16}$"}
  }
}
